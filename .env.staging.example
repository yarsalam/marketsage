# Copy to .env.staging on the staging server and chmod 600 it.
# Replace every example value. Never commit the resulting .env.staging.
STAGING_DOMAIN=staging.example.com
STAGING_BASIC_AUTH_USER=staging-reviewer
# Generate a hash with: docker run --rm -it caddy:2.11.7-alpine caddy hash-password
# Put only the resulting hash below. Do not use a plaintext password here.
STAGING_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH

# Keep the API same-origin; Caddy routes /api/* to NestJS.
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=https://staging.example.com
USER_FRONTEND_PORT=3000
USER_BACKEND_PORT=4500
PRICE_CACHE_TTL_SECONDS=900
MAX_STALE_CACHE_AGE_SECONDS=86400
LOG_LEVEL=INFO
TINDEX_API_BASE_URL=
TINDEX_API_TOKEN=

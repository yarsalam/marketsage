{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketsage:backup-manifest-v1",
  "title": "MarketSage immutable backup manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "backup_id",
    "artifact_id",
    "source_sha256",
    "source_size_bytes",
    "created_at_utc",
    "copies",
    "restore_drills"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "backup_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "copies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backup_id",
          "artifact_id",
          "relative_path",
          "sha256",
          "size_bytes",
          "location_id",
          "medium_id",
          "failure_domain",
          "offline_attested",
          "copy_path",
          "verified"
        ],
        "properties": {
          "backup_id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "location_id": {
            "type": "string",
            "minLength": 1
          },
          "medium_id": {
            "type": "string",
            "minLength": 1
          },
          "failure_domain": {
            "type": "string",
            "minLength": 1
          },
          "offline_attested": {
            "type": "boolean"
          },
          "copy_path": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "const": true
          }
        }
      }
    },
    "restore_drills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "restore_id",
          "source_location_id",
          "restored_path",
          "sha256",
          "size_bytes",
          "restored_at_utc",
          "verified"
        ],
        "properties": {
          "restore_id": {
            "type": "string",
            "minLength": 1
          },
          "source_location_id": {
            "type": "string",
            "minLength": 1
          },
          "restored_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "restored_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "const": true
          }
        }
      }
    }
  }
}

{$STAGING_DOMAIN} {
    encode zstd gzip

    # Staging access gate. Basic auth is safe only because Caddy terminates HTTPS.
    basic_auth {
        {$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy user-backend:4500
    }

    handle {
        reverse_proxy user-frontend:3000
    }
}

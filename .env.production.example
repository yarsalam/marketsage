# Copy to .env.production on the server and chmod 600 it.
# Never commit real credentials or tokens.
USER_FRONTEND_PORT=3000
USER_BACKEND_PORT=4500
# Empty means the browser uses same-origin /api via the reverse proxy.
# For local direct access, set http://localhost:4500 before building frontend.
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=https://marketsage.example.com
PRICE_CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO

# Copy to .env.production on the server and chmod 600 it.
# Never commit real credentials or tokens.
USER_FRONTEND_PORT=3000
USER_BACKEND_PORT=4500
# Empty means the browser uses same-origin /api via the reverse proxy.
# For local direct access, set http://localhost:4500 before building frontend.
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=https://marketsage.example.com
PRICE_CACHE_TTL_SECONDS=900
# Maximum age of cached prices that may be served after provider refresh failures.
# Older cache is rejected with HTTP 503; set to 0 to disable stale fallback.
MAX_STALE_CACHE_AGE_SECONDS=86400
LOG_LEVEL=INFO
# Optional Tindex developer API. Copy the HTTPS API origin from its current docs.
# Keep the token in an untracked local env/secret; never commit a real token.
TINDEX_API_BASE_URL=
TINDEX_API_TOKEN=
